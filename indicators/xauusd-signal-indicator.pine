//@version=5
indicator("Nghê Trading - XAU/USD Signal (Free)", overlay=true, max_labels_count=500)

// ================== INPUTS ==================
fastLen = input.int(20, "EMA Nhanh", minval=1)
slowLen = input.int(50, "EMA Chậm", minval=1)
rsiLen  = input.int(14, "RSI Length", minval=1)
rsiOverbought = input.int(70, "RSI Overbought", minval=1)
rsiOversold   = input.int(30, "RSI Oversold", minval=1)
rrRatio = input.float(2.0, "Tỷ Lệ R:R (TP/SL)", minval=0.5, step=0.1)
atrLen  = input.int(14, "ATR Length (đặt SL)", minval=1)
atrMult = input.float(1.5, "ATR Multiplier cho SL", minval=0.5, step=0.1)

// ================== CALCULATIONS ==================
emaFast = ta.ema(close, fastLen)
emaSlow = ta.ema(close, slowLen)
rsiVal  = ta.rsi(close, rsiLen)
atrVal  = ta.atr(atrLen)

// Điều kiện xu hướng
bullishTrend = emaFast > emaSlow
bearishTrend = emaFast < emaSlow

// RSI không quá extremos
notOverbought = rsiVal < rsiOverbought
notOversold   = rsiVal > rsiOversold

// Crossover / Crossunder
crossUp  = ta.crossover(emaFast, emaSlow)
crossDown = ta.crossunder(emaFast, emaSlow)

// ================== SIGNALS ==================
// LONG: EMA nhanh cắt lên EMA chậm + RSI không quá mua
longCondition = crossUp and bullishTrend and notOverbought

// SHORT: EMA nhanh cắt xuống EMA chậm + RSI không quá bán
shortCondition = crossDown and bearishTrend and notOversold

// Tính SL & TP
longSL  = low - atrVal * atrMult
longTP  = close + (close - longSL) * rrRatio

shortSL = high + atrVal * atrMult
shortTP = close - (shortSL - close) * rrRatio

// ================== VISUAL ==================
plot(emaFast, color=color.new(#00E676, 0), title="EMA Nhanh", linewidth=2)
plot(emaSlow, color=color.new(#FF5252, 0), title="EMA Chậm", linewidth=2)

// Background màu theo xu hướng
bgcolor(bullishTrend ? color.new(#00E676, 90) : bearishTrend ? color.new(#FF5252, 90) : na)

// Vẽ dấu hiệu vào lệnh
plotshape(longCondition, title="LONG Signal", style=shape.triangleup, location=location.belowbar, color=#00E676, size=size.small)
plotshape(shortCondition, title="SHORT Signal", style=shape.triangledown, location=location.abovebar, color=#FF5252, size=size.small)

// ================== ALERT ==================
if longCondition
    alert("XAUUSD_LONG|" + str.tostring(close, "#.##") + "|" + str.tostring(longSL, "#.##") + "|" + str.tostring(longTP, "#.##"), alert.freq_once_per_bar_close)

if shortCondition
    alert("XAUUSD_SHORT|" + str.tostring(close, "#.##") + "|" + str.tostring(shortSL, "#.##") + "|" + str.tostring(shortTP, "#.##"), alert.freq_once_per_bar_close)

// ================== TABLE HỌN HỢP ==================
var table infoTable = table.new(position.top_right, 2, 4, bgcolor=color.black, border_width=1)
if barstate.islast
    table.cell(infoTable, 0, 0, "Tín Hiệu", text_color=color.white, text_size=size.small)
    table.cell(infoTable, 1, 0, longCondition ? "LONG" : shortCondition ? "SHORT" : "-", text_color=longCondition ? #00E676 : shortCondition ? #FF5252 : #888, text_size=size.small)
    table.cell(infoTable, 0, 1, "Entry", text_color=color.white, text_size=size.small)
    table.cell(infoTable, 1, 1, str.tostring(close, "#.##"), text_color=color.white, text_size=size.small)
    table.cell(infoTable, 0, 2, "SL", text_color=color.white, text_size=size.small)
    table.cell(infoTable, 1, 2, longCondition ? str.tostring(longSL, "#.##") : shortCondition ? str.tostring(shortSL, "#.##") : "-", text_color=color.white, text_size=size.small)
    table.cell(infoTable, 0, 3, "TP", text_color=color.white, text_size=size.small)
    table.cell(infoTable, 1, 3, longCondition ? str.tostring(longTP, "#.##") : shortCondition ? str.tostring(shortTP, "#.##") : "-", text_color=color.white, text_size=size.small)
