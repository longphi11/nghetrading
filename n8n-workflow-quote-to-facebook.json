{
  "name": "Quote Telegram → Fanpage FB (tamlygiaodich)",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "5 9,15,21 * * *"
            }
          ]
        }
      },
      "id": "cron-trigger",
      "name": "Chạy quote 09h05, 15h05, 21h05 VN",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [250, 300]
    },
    {
      "parameters": {
        "url": "https://t.me/s/quotetradingvn",
        "options": {
          "response": {
            "response": {
              "responseFormat": "text"
            }
          }
        }
      },
      "id": "fetch-channel",
      "name": "Lấy bài quote mới nhất từ kênh",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [450, 300]
    },
    {
      "parameters": {
        "jsCode": "const raw = $input.first().json.data || '';\nconst blocks = String(raw).split('class=\"tgme_widget_message_text');\nif (blocks.length < 2) return [];\n\nlet seg = blocks[blocks.length - 1];\nseg = seg.slice(seg.indexOf('>') + 1);\nseg = seg.slice(0, seg.indexOf('</div>'));\n\nlet text = seg\n  .replace(/<br\\s*\\/?>/gi, '\\n')\n  .replace(/<[^>]+>/g, '')\n  .replace(/&quot;/g, '\"')\n  .replace(/&#39;/g, \"'\")\n  .replace(/&amp;/g, '&')\n  .replace(/&lt;/g, '<')\n  .replace(/&gt;/g, '>')\n  .replace(/&nbsp;/g, ' ')\n  .replace(/\\n{3,}/g, '\\n\\n')\n  .trim();\n\nconst cut = text.indexOf('======');\nif (cut > 0) text = text.slice(0, cut).trim();\nif (!text) return [];\n\nconst store = $getWorkflowStaticData('global');\nif (store.lastQuote === text) return [];\nstore.lastQuote = text;\n\nconst cta = '\\n\\n' +\n  'Đừng học thêm một mô hình nến nữa. Bạn đã học đủ rồi. Vấn đề nằm ở chỗ khác, và nó ở đây → nghetrading.com/bai-viet.html\\n' +\n  'Đã đến lúc coi trading là 1 nghề nghiệp thật sự nghiêm túc.';\n\nreturn [{ fb_content: text + cta }];"
      },
      "id": "format-fb-content",
      "name": "Định dạng nội dung FB",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [650, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://graph.facebook.com/v21.0/__FB_PAGE_ID_2__/feed",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpQueryAuth",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "message",
              "value": "={{ $json.fb_content }}"
            }
          ]
        },
        "options": {}
      },
      "id": "facebook-post",
      "name": "Đăng bài lên Fanpage",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [850, 300],
      "credentials": {
        "httpQueryAuth": {
          "id": "facebook-page-token",
          "name": "Facebook Page Access Token"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const postId = $json.id || $json.post_id;\nif (!postId) return [];\nreturn [{ post_id: postId }];"
      },
      "id": "extract-post-id",
      "name": "Lấy Post ID",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [850, 450]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://graph.facebook.com/v21.0/{{ $json.post_id }}/comments",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpQueryAuth",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "message",
              "value": "👉 Anh em tham gia nhóm Telegram cập nhật phân tích thị trường & nhận định về Vàng (XAU/USD) hàng ngày tại đây nhé: https://t.me/nhatkytradingvn"
            }
          ]
        },
        "options": {}
      },
      "id": "facebook-comment",
      "name": "Comment đầu tiên (tạo động lực)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1050, 450],
      "credentials": {
        "httpQueryAuth": {
          "id": "facebook-page-token",
          "name": "Facebook Page Access Token"
        }
      }
    },
    {
      "parameters": {
        "text": "=✅ Đã post quote lên Fanpage tamlygiaodich lúc {{ $now.format('yyyy-LL-dd HH:mm:ss') }}",
        "chatId": "__ADMIN_CHAT_ID__",
        "additionalFields": {
          "message_thread_id": 22
        }
      },
      "id": "telegram-notify",
      "name": "Thông báo về Topic 22",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [1050, 300],
      "credentials": {
        "telegramApi": {
          "id": "telegram-bot",
          "name": "Telegram Bot (@NgheTradingSupport_Bot)"
        }
      }
    }
  ],
